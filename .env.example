# ==============================================================================
# Reeler (Instagram Saved Reels Tracker & Reminder Bot) - Environment Config
# ==============================================================================

# 1. Supabase Database Configuration
# Find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key

# 2. Meta Instagram Messaging API & Webhooks (Official Graph API Bot)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_PAGE_ID=your_facebook_page_id_here
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
# Optional: Set to 'true' ONLY in non-production local development if testing webhooks without META_APP_SECRET
ALLOW_INSECURE_WEBHOOK=false

# 3. Instagram Web Session Credentials (for DM Listener)
INSTAGRAM_SESSION_ID=your_sessionid_cookie_here
INSTAGRAM_USER_ID=your_numeric_user_id_here
INSTAGRAM_CSRF_TOKEN=your_csrftoken_here

# 4. Personal User Handle (Instagram)
ADMIN_USERNAME=your_personal_instagram_username

# 5. Reminder & Watch Later Configuration
# Default reminder frequency in hours (e.g. 5, 10, 24, 48)
DEFAULT_REMINDER_HOURS=10
DM_POLLING_SECONDS=15

# 6. Application Server Settings
PORT=3000
# Reverse proxy trust setting ('1', 'loopback', 'true', or 'false' if directly exposed without a proxy)
TRUST_PROXY=1
