# ==============================================================================
# Instagram Saved Reels Tracker - Environment Configuration
# ==============================================================================

# 1. Supabase Database Configuration
# Find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key

# 2. Instagram Web Session Cookies
# 1. Open https://www.instagram.com on your desktop browser (logged into your account)
# 2. DevTools (F12 or Cmd+Option+I) -> Application -> Cookies -> https://www.instagram.com
# 3. Copy the values for 'sessionid', 'ds_user_id', and 'csrftoken':
INSTAGRAM_SESSION_ID=your_sessionid_cookie_here
INSTAGRAM_USER_ID=your_numeric_user_id_here
INSTAGRAM_CSRF_TOKEN=your_csrftoken_here

# 3. Telegram Bot Configuration (For 24/7 Cloud Reminders & 1-tap Sharing)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 4. Personal User Handle (Instagram)
ADMIN_USERNAME=your_personal_instagram_username

# 5. Reminder & Watch Later Configuration
# Reminder frequency in hours (e.g. 5, 10, 24, 48)
DEFAULT_REMINDER_HOURS=10
DM_POLLING_SECONDS=15

# 6. Application Server Settings
PORT=3000
